with open("history.txt", "r") as f:
    lines = [line.strip() for line in f if line.strip()]

count = 0
highest = 0
for line in lines:
    parts = line.split()
    if len(parts) < 3:
        continue
    try:
        score = int(line.split()[1])
    except ValueError:
        continue
    count += 1
    if score > highest:
        highest = score

print("records :", n)
print("highest :", highest)

