def grade(score):
    if score >= 80:
        return "A"
    elif score >= 70:
        return "B"
    elif score >= 60:
        return "C"
    else:
        return "D"
 
n = int(input("n: "))
for i in range(n):
    score = int(input("enter score: "))
    print(score, ":", grade(score))

