def update_score(scores, name, points):
    if name not in scores or points > scores[name]:
        scores[name] = points
 
try:
    with open("highscore.txt", "r") as f:
        lines = f.readlines()
    scores = {}
    for line in lines:
        parts = line.split()
        scores[parts[0]] = int(parts[1])
except FileNotFoundError:
    scores = {}
 
n = int(input("actions: "))
for i in range(n):
    cmd = input("enter command: ").split()
    action = cmd[0]
    name = cmd[1]
    if action == "add":
        try:
            points = int(cmd[2])
            update_score(scores, name, points)
        except:
            print("try again :", name)
    else:
        if name in scores:
            print(scores[name])
        else:
            print("not found :", name)
 
with open("highscore.txt", "w") as f:
    for name in sorted(scores):
        f.write(name + " " + str(scores[name]) + "\n")
 
with open("highscore.txt", "r") as f:
    saved_lines = f.readlines()
print("successful save", len(saved_lines), "items  in highscore.txt")

