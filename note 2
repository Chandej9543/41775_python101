int Example code :

print(10 + 5) # addition (10 + 5 = 15)
print(10 - 5) # subtraction (10 - 5 = 5)
print(10 * 5) # multiplication (10 * 5 = 50)
print(10 / 5) # division (10 / 5 = 2.0)
print(10 // 5) # floor division (10 // 5 = 2)
print(10 % 5) # modulus (10 % 5 = 0)
