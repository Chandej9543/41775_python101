bool Example code :

print(10 > 5) # True (10 is greater than 5)
print(10 < 5) # False (10 is not less than 5)
print(10 == 5) # False (10 is not equal to 5)
print(10 != 5) # True (10 is not equal to 5)
print(10 >= 5) # True (10 is greater than or equal to 5)
print(10 <= 5) # False (10 is not less than or equal to 5)
print(10 > 5 and 10 < 15) # True (10 is greater than 5 and less than 15)
print(10 > 5 or 10 < 5) # True (10 is greater than 5 or less than 5)
print(10 + 5 > 15) # False (10 + 5 is not greater than 15)
print(10 + 5 < 15) # True (10 + 5 is less than 15)
print(10 + 5 == 15) # True (10 + 5 is equal to 15)
print(10 - 5 != 15) # True (10 - 5 is not equal to 15)

none example code :

print(None) # None (represents the absence of a value)
print(type(None)) # <class 'NoneType'>
print(None == None) # True (None is equal to None)
print(None is None) # True (None is the same object as None)
print(None is not None) # False (None is not the same object as None)
x = None
print(x) # None (x is assigned to None)

------------------------------------------

dict(key-value pair) example code :

dict(key) #correct way to create a dictionary
dict[key] = value # adding or updating a key-value pair
dict.keys() # returns a view object of the keys in the dictionary
dict.values() # returns a view object of the values in the dictionary

type example code :

print(type(10)) # <class 'int'>
print(type(10.5)) # <class 'float'>
print(type("Hello")) # <class 'str'>
print(type(True)) # <class 'bool'>
print(type(None)) # <class 'NoneType'>
print(type([])) # <class 'list'>
print(type(())) # <class 'tuple'>

list vs tuple example code :

list = [1, 2, 3, 4, 5]
tuple = (1, 2, 3, 4, 5)

print(list) # [1, 2, 3, 4, 5]
print(tuple) # (1, 2, 3, 4, 5)

print(list[0]) # 1 (first element of list)
print(tuple[0]) # 1 (first element of tuple)

list.append(6) # add 6 to the end of the list
print(list) # [1, 2, 3, 4, 5, 6]
tuple.append(6) # error (tuples are immutable)  
print(tuple) # (1, 2, 3, 4, 5)

list.insert(0, 0) # add 0 to the beginning of the list
print(list) # [0, 1, 2, 3, 4, 5, 6]
tuple.insert(0, 0) # error (tuples are immutable)
print(tuple) # (1, 2, 3, 4, 5)

list.remove(3) # remove 3 from the list
print(list) # [0, 1, 2, 4, 5, 6]
tuple.remove(3) # error (tuples are immutable)
print(tuple) # (1, 2, 3, 4, 5)

